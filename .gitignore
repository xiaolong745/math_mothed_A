# Local environments, Python cache, editor state and credentials
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*.swp
*.tmp
*.sync_tmp
*.log
*.deb

# Official inputs are versioned; generated evaluator outputs are not.
/data/*
!/data/README.md
!/data/config.txt
!/data/case_[0-9][0-9][0-9].json

# Keep only published evidence in results/. All caches, traces and run state
# remain available locally and are excluded from Git by default.
/results/*
!/results/README.md
!/results/stage1/
/results/stage1/*
!/results/stage1/summary.csv
!/results/stage1/candidate_results.csv
!/results/stage1/benchmark_metrics.json
